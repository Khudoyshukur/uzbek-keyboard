#!/bin/bash
# Runs as root after the .pkg installs. Enables the layout for the logged-in
# user through macOS's input-source API (as System Settings does), so it shows
# in the fn/🌐 switcher. Writing com.apple.HIToolbox prefs directly instead
# makes System Settings list the layout many times.
user=$(stat -f %Su /dev/console)
{ [ -z "$user" ] || [ "$user" = root ]; } && exit 0
uid=$(id -u "$user")
# A per-user copy from install.sh would show up twice
rm -rf "/Users/$user/Library/Keyboard Layouts/UzbekKeyboard.bundle"
tis() {
  launchctl asuser "$uid" sudo -u "$user" osascript -l JavaScript - "$@" <<'JS'
function run(argv) {
  ObjC.import("Carbon");
  ObjC.bindFunction("TISCreateInputSourceList", ["void *", ["id", "bool"]]);
  ObjC.bindFunction("TISRegisterInputSource", ["int", ["id"]]);
  ObjC.bindFunction("TISEnableInputSource", ["int", ["void *"]]);
  ObjC.bindFunction("TISDisableInputSource", ["int", ["void *"]]);
  ObjC.bindFunction("CFArrayGetCount", ["long", ["void *"]]);
  ObjC.bindFunction("CFArrayGetValueAtIndex", ["void *", ["void *", "long"]]);
  var action = argv[0];
  if (action === "register") return String($.TISRegisterInputSource($.NSURL.fileURLWithPath(argv[1])));
  function find(all) {
    var l = $.TISCreateInputSourceList(
      $.NSDictionary.dictionaryWithObjectForKey(argv[1], "TISPropertyInputSourceID"), all);
    var out = [];
    if (l) for (var i = 0, n = $.CFArrayGetCount(l); i < n; i++) out.push($.CFArrayGetValueAtIndex(l, i));
    return out;
  }
  var on = find(false);  // only enabled sources
  if (action === "enable" && on.length === 0) {
    var all = find(true);
    if (all.length) $.TISEnableInputSource(all[0]);
  }
  if (action === "disable") on.forEach(function (x) { $.TISDisableInputSource(x); });
  return String(find(false).length);  // how many are enabled now
}
JS
}
tis register "/Library/Keyboard Layouts/UzbekKeyboard.bundle" >/dev/null 2>&1 || true
tis enable io.github.khudoyshukur.keyboardlayout.uzbek.uzbekkeyboard >/dev/null 2>&1 || true

# Optionally log out so the change takes full effect, as install.sh offers.
# Detached, so Installer can finish and show its "complete" screen first.
launchctl asuser "$uid" sudo -u "$user" nohup /bin/bash -c '
  sleep 2
  ans=$(osascript -e "button returned of (display dialog \"Özgarişlar kuçga kiriši uçun tizimdan çiqib, qayta kiriş kerak.\" & return & return & \"Hozir çiqasizmi?\" with title \"Uzbek Latin\" buttons {\"Keyinroq\", \"Çiqiş\"} default button \"Çiqiş\" with icon note)" 2>/dev/null)
  [ "$ans" = "Çiqiş" ] && osascript -e "tell application \"System Events\" to log out"
' >/dev/null 2>&1 &
exit 0
